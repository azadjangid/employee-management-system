{
  "name": "employeehub-server",
  "version": "1.0.0",
  "description": "EmployeeHub REST API (Express + PostgreSQL)",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seed.js",
    "db:reset": "node src/db/migrate.js --reset && node src/db/seed.js",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\""
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "supertest": "^7.3.2"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  }
}
