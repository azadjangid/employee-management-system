PORT=5000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ems
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development
# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
# How long a login lasts (e.g. 12h, 7d). "Remember me" uses REMEMBER_ME_EXPIRES_IN.
JWT_EXPIRES_IN=12h
REMEMBER_ME_EXPIRES_IN=7d
# Where password reset links point (the frontend).
APP_URL=http://localhost:5173
# Where uploaded receipts are stored (relative to server/).
UPLOAD_DIR=uploads
